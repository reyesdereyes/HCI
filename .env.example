# ============================================
# CONFIGURACIÓN DE SUPABASE
# ============================================

# URL de tu proyecto en Supabase
# Ejemplo: https://tuproyecto.supabase.co
VITE_SUPABASE_URL=your_supabase_url_here

# Clave pública (anon key) de Supabase
# La encuentras en: Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# CONFIGURACIÓN DE WHATSAPP
# ============================================

# Número de WhatsApp para cotizaciones (con código de país)
# Ejemplo: 584141234567 (Venezuela)
VITE_WHATSAPP_NUMBER=your_whatsapp_number_here

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================

# Nombre de la empresa
VITE_APP_NAME=Hitach Cool Import

# URL base de la aplicación (para producción)
# VITE_APP_URL=https://tudominio.com

# ============================================
# NOTAS IMPORTANTES
# ============================================

# 1. Copia este archivo como .env en la raíz del proyecto
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA subas el archivo .env a Git (ya está en .gitignore)
# 4. Las variables deben empezar con VITE_ para ser accesibles en el frontend
# 5. Después de cambiar variables, reinicia el servidor de desarrollo

# ============================================
# CÓMO OBTENER LAS CREDENCIALES
# ============================================

# SUPABASE:
# 1. Ve a https://supabase.com
# 2. Abre tu proyecto
# 3. Ve a Settings > API
# 4. Copia la URL y la anon key

# WHATSAPP:
# 1. Usa el número de teléfono con código de país
# 2. Sin espacios, guiones ni símbolos
# 3. Ejemplo: 584141234567 (58 = Venezuela, 414 = código de área)
